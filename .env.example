# Paste your MongoDB connection string, including a database name.
MONGODB_URI=
# Gmail example: use a Google App Password, never your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Verified sender; usually the same address as SMTP_USER.
SMTP_FROM=
# Set to your deployed origin before going live.
SITE_URL=http://localhost:3017
